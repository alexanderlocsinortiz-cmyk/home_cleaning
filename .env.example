APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_CHECKOUT_REDIRECT_ENABLED=true
PAYMONGO_API_URL=https://api.paymongo.com
PAYMONGO_CA_BUNDLE=
PAYMONGO_DISABLE_PROXY=true
PAYMONGO_TIMEOUT_SECONDS=10
PAYMONGO_CONNECT_TIMEOUT_SECONDS=5
PAYMONGO_RETRY_TIMES=2
PAYMONGO_RETRY_SLEEP_MS=250
PAYMONGO_MAYA_METHOD_TYPE=paymaya
UNPAID_ONLINE_PAYMENT_EXPIRY_MINUTES=30

GOOGLE_MAPS_API_KEY=

DAILY_API_KEY=
DAILY_DOMAIN=
DAILY_API_URL=https://api.daily.co/v1
DAILY_CA_BUNDLE=
DAILY_DISABLE_PROXY=true
DAILY_ROOM_TTL_HOURS=6
DAILY_TOKEN_TTL_MINUTES=120

# Expo push delivery. Push jobs use the existing emails queue by default.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# EXPO_PUSH_ACCESS_TOKEN=
EXPO_PUSH_QUEUE=emails
EXPO_PUSH_TIMEOUT_SECONDS=10

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cleanflow_app
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FILESYSTEM_PRIVATE_DISK=local
FILESYSTEM_PUBLIC_DISK=public
FILESYSTEM_PROOF_DISK=local
FILESYSTEM_PRIVATE_PREFIX=private
FILESYSTEM_PUBLIC_PREFIX=public
FILESYSTEM_PROOF_PREFIX=proofs
DATABASE_BACKUP_DISK=s3
DATABASE_BACKUP_PREFIX=database-backups
DATABASE_BACKUP_RETENTION_COUNT=30
# Optional absolute paths when pg_dump/mysqldump are not available on PATH.
# DB_BACKUP_PG_DUMP_PATH=
# DB_BACKUP_MYSQLDUMP_PATH=
PROOF_UPLOAD_MAX_REQUEST_KB=131072
PROOF_UPLOAD_MAX_VIDEO_KB=102400
QUEUE_CONNECTION=database
MOBILE_MAX_ACTIVE_TOKENS=5
SECURITY_EVENT_RETENTION_DAYS=365

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
# Use separate buckets: keep private documents/backups away from public media.
AWS_PRIVATE_BUCKET=
AWS_PUBLIC_BUCKET=
AWS_PRIVATE_URL=
AWS_PUBLIC_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Optional local PHP CA bundle path; keep TLS verification enabled.
AWS_CA_BUNDLE=

# Optional Cloudflare R2 credentials for booking proof and public-media disks.
# Use these when the main `s3` disk is supplied by Laravel Cloud or another
# S3 provider. Do not reuse platform-managed AWS credentials for R2.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PRIVATE_URL=
R2_PUBLIC_URL=
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
